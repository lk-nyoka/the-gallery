# The Gallery runs fully without any of this: the template writer is free, offline and deterministic.
# To have a model write (and translate) the words, copy this file to .env and fill ONE option.

# Which model writes the words: template | foundry_local | azure_openai | openai_compatible | auto (default)
# auto = Azure if its keys are set, else an OpenAI-compatible endpoint if set, else the template writer.
# Any failure falls back to the template writer; verification is identical either way.
# MODEL_PROVIDER=foundry_local

# Option 0 (free, offline): Microsoft Foundry Local, on-device. pip install -r requirements-foundry.txt
# First start downloads the model once (~1 GB for 1.5b, ~0.5 GB for 0.5b) into backend/data/foundry_cache.
# FOUNDRY_MODEL=qwen2.5-0.5b
# FOUNDRY_CACHE_DIR=

# Option A: Azure OpenAI / Microsoft Foundry (e.g. with Azure for Students credit)
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# Option B: any OpenAI-compatible chat endpoint (several providers have free tiers)
# LLM_BASE_URL=https://<provider>/v1
# LLM_API_KEY=
# LLM_MODEL=

# Which match opens first: file:<name in backend/data/organiser> | espn:<id> | archive:<statsbomb id> | synthetic
# Without it: the first organiser file if one exists, else the bundled validation match.
# For the judged demo, point this at the organisers' data, e.g. DEFAULT_SOURCE=file:match_001.json
# DEFAULT_SOURCE=

# Real-match validation sources (ESPN feed, StatsBomb archive). OFF by default: the hackathon requires
# synthetic data. Turn on only for private validation runs; never record the demo with them.
# ENABLE_VALIDATION_SOURCES=1
# Which agents call the model (default: all for hosted models; writer,localiser for Foundry Local on a laptop CPU)
# MODEL_AGENTS=editor,analyst,writer,localiser
